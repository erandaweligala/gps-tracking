# Server
PORT=4000

# Postgres connection string (PostGIS-enabled)
DATABASE_URL=postgres://gps:gps@localhost:5432/gps_tracking

# Secret used to sign/verify all JWTs. Use a long random value in production.
JWT_SECRET=dev-secret-change-me

# Allowed origin(s) for the dashboard (CORS + Socket.IO).
# Comma-separate multiple origins. Note that `localhost` and `127.0.0.1` are
# distinct origins to the browser, so list both if you use either in dev.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
